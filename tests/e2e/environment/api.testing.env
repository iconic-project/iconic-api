# E2E / cloud-agent values only. Not for production.
# Copied to iconic-api/.env.testing by up.sh when that file does not already exist.
# Pest uses this; e2e browser runs use the main .env. APP_KEY is generated at up.sh time
# only on .env — Pest is not part of the e2e run.

APP_NAME=Iconic
APP_ENV=testing
APP_KEY=
SENSITIVE_DATA_KEY=base64:YW5ha2F0YS1lMmUtc2Vuc2l0aXZlLWRhdGEta2V5MzI=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

FRONTEND_ENGINE_URL=http://localhost:3000
FRONTEND_PANEL_URL=http://localhost:3001
FRONTEND_PORTAL_URL=http://localhost:3002
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,localhost:3002

DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=iconic_app
DB_PASSWORD=e2e-app-password

SESSION_DRIVER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_FROM_ADDRESS="hello@iconic.test"
MAIL_FROM_NAME="${APP_NAME}"
