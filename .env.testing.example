# Testing environment. Copy to .env.testing (gitignored) and fill secrets.
# DB_CONNECTION and DB_DATABASE are pinned in phpunit.xml (mysql / iconic_test)
# so tests can never hit the app database even if this file is missing.
APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
# Dedicated test key — not APP_KEY. phpunit.xml pins the same value.
SENSITIVE_DATA_KEY=base64:YW5ha2F0YS1waHB1bml0LXNlbnNpdGl2ZS1rZXkzMiE=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

FRONTEND_ENGINE_URL=http://localhost:3000
FRONTEND_PANEL_URL=http://localhost:3001
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001

# Credentials only — driver and database name come from phpunit.xml.
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=iconic_app
DB_PASSWORD=

SESSION_DRIVER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

TELESCOPE_ENABLED=false

# yacht remains available until Sprint 22. The default is hotel.
ICONIC_SEED_MODE=hotel

STRIPE_SECRET=
STRIPE_PUBLISHABLE=
STRIPE_WEBHOOK_SECRET=whsec_test
STRIPE_MODE=test
