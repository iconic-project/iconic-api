# Application
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Dedicated key for passport numbers and medical / dietary / accessibility notes.
# Same format as APP_KEY (base64: + 32 bytes). Never reuse APP_KEY.
# Generate: php artisan key:generate --show
SENSITIVE_DATA_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Frontends
FRONTEND_ENGINE_URL=http://localhost:3000
FRONTEND_PANEL_URL=http://localhost:3001
FRONTEND_PORTAL_URL=http://localhost:3002
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,localhost:3002

# Database — one MySQL 8 database. RMS and CRM share the default `mysql`
# connection. Do not add separate rms/crm connections.
# App database: iconic. Test database: iconic_test (see .env.testing.example).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=iconic
DB_USERNAME=iconic_app
DB_PASSWORD=

# MySQL container (docker-compose). Passwords are never committed.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=iconic_app
MYSQL_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis — sessions, queues, cache and Horizon.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — SMTP. Locally Mailpit (UI http://localhost:8025, SMTP 1025).
# Production: set MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD
# to the sending mailbox. The From address is still a client question
# (Reply-To is legal_entity.email from business rules, today info@iconic.co).
# Do not use the failover mailer — a failed send must stay failed.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_RESERVATIONS=reservations@iconic.co

# Inbound CRM inbox. Local/e2e poll Mailpit's HTTP API. Production sets
# INBOX_DRIVER=graph once TEC-002 app-registration keys exist. Empty Graph
# keys skip the poll; outbound mail stays on SMTP either way.
INBOX_DRIVER=mailpit
MAILPIT_URL=http://mailpit:8025
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telescope — request/query debugger. Local only. Off in tests (phpunit.xml).
TELESCOPE_ENABLED=true

# Stripe (TEC-001). Local/test mode until the client provides keys.
# The RMS creates payment links; Stripe webhooks settle them. No card data is stored.
STRIPE_SECRET=
STRIPE_PUBLISHABLE=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test
